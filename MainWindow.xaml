<Window x:Class="Up02Variant3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Атмосферное давление | Тула"
        Width="1120" Height="760" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F1F4F2" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Атмосферное давление" Foreground="{StaticResource InkBrush}"
                           FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Тула  /  симуляция показаний" Foreground="{StaticResource MutedBrush}"
                           FontSize="13" Margin="1,3,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#E4F1EB" CornerRadius="4" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#19745B"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="StateText" Text="ИЗМЕРЕНИЕ" FontSize="11"
                               FontWeight="Bold" Foreground="#19745B" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="292" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Динамика давления" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="мм рт. ст.  ·  последние 60 измерений" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="Текущее" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0" />
                            <Ellipse Width="8" Height="8" Fill="{StaticResource OrangeBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="Среднее" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource CanvasBrush}" CornerRadius="4"
                            Margin="0,10,0,0">
                        <Canvas x:Name="PlotCanvas" SizeChanged="PlotCanvas_SizeChanged" />
                    </Border>
                    <TextBlock Grid.Row="2" Text="Обновление каждые 1,5 секунды"
                               VerticalAlignment="Bottom" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ТЕКУЩЕЕ ПОКАЗАНИЕ" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                            <TextBlock x:Name="CurrentPressureText" Text="—" FontSize="42"
                                       FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" />
                            <TextBlock Text="мм" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Bottom" Margin="8,0,0,8" />
                        </StackPanel>
                        <TextBlock x:Name="CurrentTimeText" Text="Ожидание данных"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="#FCF4EC" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="СРЕДНЕЕ ПРОГНОЗНОЕ" FontSize="11" FontWeight="Bold"
                                   Foreground="#94603A" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                            <TextBlock x:Name="ForecastPressureText" Text="—" FontSize="34"
                                       FontWeight="SemiBold" Foreground="#B5682F" />
                            <TextBlock Text="мм" FontSize="13" Foreground="#94603A"
                                       VerticalAlignment="Bottom" Margin="8,0,0,7" />
                        </StackPanel>
                        <TextBlock Text="Среднее по последним 12 точкам"
                                   FontSize="12" Foreground="#94603A" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ЗА ТЕКУЩИЙ ПЕРИОД" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" />
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Минимум" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="MinimumPressureText" Text="—" HorizontalAlignment="Right"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Максимум" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="MaximumPressureText" Text="—" HorizontalAlignment="Right"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Button x:Name="PauseButton" Content="Пауза" Click="PauseButton_Click"
                        Background="{StaticResource GreenBrush}" Foreground="White"
                        HorizontalContentAlignment="Center" Margin="0,0,0,10" />
                <Button Content="Сбросить график" Click="ResetButton_Click"
                        Background="#E3E9E6" Foreground="{StaticResource InkBrush}"
                        HorizontalContentAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <TextBlock Text="Источник данных: генератор случайных чисел"
                       VerticalAlignment="Bottom" FontSize="11" Foreground="{StaticResource MutedBrush}" />
            <TextBlock x:Name="SampleCountText" Text="0 измерений" HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" FontSize="11" Foreground="{StaticResource MutedBrush}" />
        </Grid>
    </Grid>
</Window>